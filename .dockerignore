# Everything here would otherwise be copied into the build context and sent to
# the daemon on every build. node_modules alone is hundreds of megabytes, and
# copying it in would also shadow the clean tree `npm ci` just installed.

node_modules
dist
.angular
.git
.github
.vscode
.idea
coverage
*.log
npm-debug.log*
.env
.env.*
!.env.example
Dockerfile
.dockerignore
README.md
CONTRIBUTING.md
